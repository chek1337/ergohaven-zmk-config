#include "keys_ru.h"
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        cap_sen: cap_sen {
            compatible = "zmk,behavior-hold-tap";
            label = "CAP_SEN";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-while-undecided;
        };

        mouse_layer: mouse_layer {
            compatible = "zmk,behavior-sticky-key";
            label = "MOUSE_LAYER";
            bindings = <&mo>;
            #binding-cells = <1>;
            release-after-ms = <200>;
        };

        hmr_l: hmr_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <44 45 35 34 33 32 31 30 18 19 20 21 22 23 11 10 9 8 7 6 41 42 43>;
        };

        hmr_r: hmr_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 5 17 29 28 37 36 27 26 25 24 12 13 14 15 16 4 3 2 1 40 38 39>;
        };

        skq: skq {
            compatible = "zmk,behavior-sticky-key";
            label = "SKQ";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };

        zip_auto_mouse: zip_auto_mouse {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
            require-prior-idle-ms = <800>;
            excluded-positions = <>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cmben {
            bindings = <&layer_en>;
            key-positions = <3 4>;
            layers = <1>;
        };

        cmbru {
            bindings = <&layer_ru>;
            key-positions = <4 3>;
            layers = <0>;
        };

        tmux_focus {
            bindings = <&kp LC(SPACE)>;
            key-positions = <39 16>;
            layers = <1 0>;
        };

        ctrl_shift_v_ru {
            bindings = <&en LS(LC(V))>;
            key-positions = <28 25>;
            layers = <1>;
        };

        ctrl_shift_v_en {
            bindings = <&kp LS(LC(V))>;
            key-positions = <25 28>;
            layers = <0>;
        };

        ctrl_shift_c_ru {
            bindings = <&en LS(LC(C))>;
            key-positions = <25 27>;
            layers = <1>;
        };

        ctrl_shift_c_en {
            bindings = <&kp LS(LC(C))>;
            key-positions = <25 27>;
            layers = <0>;
        };

        alt_tab {
            bindings = <&kp LA(TAB)>;
            key-positions = <14 38>;
        };

        first_capital_letter {
            bindings = <&skq RIGHT_SHIFT>;
            key-positions = <>;
        };

        capslock_one_word {
            bindings = <&caps_word>;
            key-positions = <19 21>;
        };

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <19 22>;
        };

        window_mode_nvim {
            bindings = <&kp LC(W)>;
            key-positions = <15 39>;
        };

        russian_ha {
            bindings = <&kp RU_CYRILLIC_HA>;
            key-positions = <8 7>;
            layers = <1>;
        };

        russian_tverd_znak {
            bindings = <&kp RU_CYRILLIC_HARD_SIGN>;
            key-positions = <9 8>;
            layers = <1>;
        };
    };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N2))>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N1))>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &to_ru>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&none  &kp Q              &kp W              &kp E                &kp R           &kp T                      &kp Y  &kp U           &kp I                 &kp O               &none               &kp F13
&none  &hmr_l LEFT_GUI A  &hmr_l LEFT_ALT S  &hmr_l LEFT_SHIFT D  &hmr_l LCTRL F  &kp G                      &kp H  &hmr_r RCTRL J  &hmr_r RIGHT_SHIFT K  &hmr_r RIGHT_ALT L  &hmr_r RIGHT_GUI P  &none
&none  &kp Z              &kp X              &kp C                &kp V           &kp B                      &kp N  &kp M           &kp LEFT_BRACKET      &kp RIGHT_BRACKET   &none               &none
                          &none              &none                &kp TAB         &kp SPACE  &mo 2    &mo 3  &mo 9  &none           &none                 &none
            >;

            display-name = "Base";
        };

        ru {
            display-name = "Ru";
            bindings = <
&none  &kp RU_CYRILLIC_SHORT_I         &kp RU_CYRILLIC_TSE               &kp RU_CYRILLIC_U                 &kp RU_CYRILLIC_KA          &kp RU_CYRILLIC_IE                  &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE         &kp RU_CYRILLIC_SHA                &kp RU_CYRILLIC_SHCHA            &kp RU_CYRILLIC_ZE                &kp F13
&none  &hmr_l LEFT_GUI RU_CYRILLIC_EF  &hmr_l LEFT_ALT RU_CYRILLIC_YERU  &hmr_l LEFT_SHIFT RU_CYRILLIC_VE  &hmr_l LCTRL RU_CYRILLIC_A  &kp RU_CYRILLIC_PE                  &kp RU_CYRILLIC_ER  &hmr_r RCTRL RU_CYRILLIC_O  &hmr_r RIGHT_SHIFT RU_CYRILLIC_EL  &hmr_r RIGHT_ALT RU_CYRILLIC_DE  &hmr_r RIGHT_GUI RU_CYRILLIC_ZHE  &none
&none  &kp RU_CYRILLIC_YA              &kp RU_CYRILLIC_CHE               &kp RU_CYRILLIC_ES                &kp RU_CYRILLIC_EM          &kp RU_CYRILLIC_I                   &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN   &kp RU_CYRILLIC_BE                 &kp RU_CYRILLIC_YU               &kp RU_CYRILLIC_E                 &none
                                       &none                             &none                             &kp TAB                     &kp SPACE           &mo 2    &mo 4  &mo 9               &none                       &none                              &none
            >;
        };

        nav {
            bindings = <
&none  &kp F1  &kp F2   &kp F3   &kp F4   &none                  &none     &none     &none   &none      &none  &none
&none  &kp F5  &kp F6   &kp F7   &kp F8   &none                  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none  &none
&none  &kp F9  &kp F10  &kp F11  &kp F12  &none                  &none     &none     &none   &none      &none  &none
               &none    &none    &none    &none  &none    &mo 5  &none     &none     &none   &none
            >;

            display-name = "Nav";
        };

        sym_en {
            bindings = <
&none  &kp GRAVE      &kp LESS_THAN  &kp GREATER_THAN  &kp DQT        &kp SINGLE_QUOTE                  &kp TILDE  &kp AT     &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp HASH   &none
&none  &kp EXCL       &kp FSLH       &kp MINUS         &kp EQUAL      &kp PIPE                          &kp PRCNT  &kp UNDER  &kp LPAR          &kp RPAR           &kp QMARK  &none
&none  &kp BACKSLASH  &kp ASTRK      &kp PLUS          &kp AMPERSAND  &kp DOLLAR                        &kp COMMA  &kp DOT    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp CARET  &none
                      &none          &none             &kp SEMI       &kp COLON         &mo 5    &none  &none      &none      &none             &none
            >;

            display-name = "Symbols";
        };

        sym_ru {
            display-name = "Symbols";
            bindings = <
&none  &en GRAVE         &en LESS_THAN  &en GREATER_THAN  &kp RU_DQT     &en SQT                     &en TILDE     &en AT      &en LEFT_BRACE  &en RIGHT_BRACE  &en HASH      &none
&none  &kp EXCL          &kp RU_FSLH    &kp MINUS         &kp EQUAL      &en PIPE                    &kp PRCNT     &kp UNDER   &kp LPAR        &kp RPAR         &kp RU_QMARK  &none
&none  &kp RU_BACKSLASH  &kp ASTERISK   &kp PLUS          &en AMPERSAND  &en DOLLAR                  &kp RU_COMMA  &kp RU_DOT  &en LBKT        &en RBKT         &kp CARET     &none
                         &none          &none             &kp SEMI       &en COLON   &mo 5    &none  &none         &none       &none           &none
            >;
        };

        adj {
            bindings = <
&bootloader  &none  &none  &none  &none  &none                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4     &bt BT_CLR
&none        &none  &none  &none  &none  &none                  &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &kp PRINTSCREEN  &studio_unlock
&none        &none  &none  &none  &none  &none                  &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &none            &none
                    &none  &none  &none  &none  &none    &none  &none         &none         &none             &none
            >;

            display-name = "Adjust";
        };

        mouse {
            bindings = <
&none  &none  &none     &none     &none     &none                  &none  &none     &none     &none     &none  &none
&none  &mo 7  &mkp MB3  &mkp MB2  &mkp MB1  &none                  &none  &mkp MB1  &mkp MB2  &mkp MB3  &mo 7  &none
&none  &mo 8  &none     &none     &none     &none                  &none  &none     &none     &none     &mo 8  &none
              &none     &none     &none     &none  &none    &none  &none  &none     &none     &none
            >;

            display-name = "Mouse";
        };

        scroll {
            bindings = <
&none  &none  &none     &none     &none     &none                  &none  &none     &none     &none     &none  &none
&none  &none  &mkp MB3  &mkp MB2  &mkp MB1  &none                  &none  &mkp MB1  &mkp MB2  &mkp MB3  &none  &none
&none  &none  &none     &none     &none     &none                  &none  &none     &none     &none     &none  &none
              &none     &none     &none     &none  &none    &none  &none  &none     &none     &none
            >;

            display-name = "Scroll";
        };

        sniper {
            bindings = <
&none  &none  &none     &none     &none     &none                  &none  &none     &none     &none     &none  &none
&none  &none  &mkp MB3  &mkp MB2  &mkp MB1  &none                  &none  &mkp MB1  &mkp MB2  &mkp MB3  &none  &none
&none  &none  &none     &none     &none     &none                  &none  &none     &none     &none     &none  &none
              &none     &none     &none     &none  &none    &none  &none  &none     &none     &none
            >;

            display-name = "Sniper";
        };

        additional_nav {
            bindings = <
&none  &kp NUMBER_9   &kp NUMBER_8  &kp NUMBER_7  &kp NUMBER_6  &kp N5                           &none      &kp RS(ENTER)  &kp RC(DELETE)      &kp DELETE                 &kp PRINTSCREEN  &none
&none  &kp NUMBER_4   &kp NUMBER_3  &kp NUMBER_2  &kp NUMBER_1  &kp NUMBER_0                     &none      &kp ENTER      &kp RC(BSPC)        &kp BSPC                   &kp ESCAPE       &none
&none  &kp PAGE_DOWN  &kp PG_UP     &kp HOME      &kp END       &none                            &en COMMA  &en DOT        &kp RU_CYRILLIC_HA  &kp RU_CYRILLIC_HARD_SIGN  &none            &none
                      &none         &none         &none         &skq LEFT_SHIFT  &none    &none  &none      &none          &none               &none
            >;
        };

        layer_10 {
            display-name = "Symbols";
            bindings = <
&kp RU_CYRILLIC_IO  &en HASH          &en LT    &kp EQUAL     &en GT       &en GRAVE                  &en CARET  &kp RU_DQT  &kp UNDER    &en SQT   &none       &none
&kp RU_NUMERO       &kp RU_BACKSLASH  &kp LPAR  &kp MINUS     &kp RPAR     &kp PLUS                   &kp PRCNT  &en LBRC    &kp RU_SEMI  &kp RBRC  &kp EXCL    &kp RU_QMARK
&none               &kp RU_COMMA      &kp STAR  &kp RU_COLON  &kp RU_FSLH  &en DLLR                   &en AT     &en PIPE    &en TILDE    &en AMPS  &kp RU_DOT  &none
                                      &none     &none         &none        &none      &mo 5    &none  &none      &none       &en LBKT     &en RBKT
            >;
        };
    };
};

&trackball { cpi = <1000>; };

&trackball_listener {
    input-processors = <&zip_auto_mouse 6 500>, <&zip_xy_scaler 9 20>;

    scroller {
        layers = <7>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_scaler 1 32>,
            <&zip_xy_to_scroll_mapper>;
    };

    sniper {
        layers = <8>;
        input-processors = <&zip_xy_scaler 1 4>;
    };
};
